{
  "name": "playwright-salesforce-lightning",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript automation for Salesforce Lightning: shadow-DOM components, Visualforce iframes, REST, SOQL and Composite API",
  "author": "Mukesh Ningadali",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sut": "node sut/server.mjs",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
